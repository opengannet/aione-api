[Unit]
Description=New API Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/aione-api
EnvironmentFile=/opt/aione-api/.env
ExecStart=/opt/aione-api/new-api --port 3000 --log-dir /opt/aione-api/logs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
